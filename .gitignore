# build artifacts
build/
app/build/
*.log

# Python cache
__pycache__/
*.pyc

# portable staging dir (recreated by _pack_portable.ps1)
dist/TextureGeneratorQt/
dist/TextureGeneratorQt-portable/
dist/_download/

# The portable zip is a build artifact and ships as a GitHub release asset, not
# in git. It is 70 MB and regenerated every release, so committing it added a
# fresh copy to history each time (GitHub warns above 50 MB per file). Anyone
# who wants it: the "Releases" page, or run _pack_portable.ps1 yourself.
dist/TextureGeneratorQt-portable.zip

# AI depth model + ONNX Runtime binary. ~61 MB together, so they are fetched
# with _get_depth_model.ps1 instead of living in git. The small ORT headers in
# third_party/onnxruntime/include/ ARE committed - the build needs them.
app/models/*.onnx
app/third_party/onnxruntime/bin/*.dll

# Real-ESRGAN upscaler: 6 MB binary + 42 MB of weights. Fetched with
# _get_realesrgan.ps1 and copied into the portable package by _pack_portable.ps1.
app/tools/realesrgan-ncnn-vulkan/

# editor
.vscode/
.idea/

# Renders written next to the binaries by the visual checks (rotation sweep,
# patch synthesis, seam visual, vorient probes). Outputs, not sources.
/orient.png
/rot_*.png
/shape_*.png
/patch_*.png
app/orient.png
app/rot_*.png
app/shape_*.png
app/patch_*.png
app/vorient_*.png
app/tmptg_window.png
